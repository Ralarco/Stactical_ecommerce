{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@stactical/shared-types": [
        "../../packages/shared-types/src"
      ],
      "@stactical/events": [
        "../../packages/events/src"
      ],
      "@stactical/config": [
        "../../packages/config/src"
      ]
    }
  },
  "include": [
    "../../packages/*/src/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
